# DB (Neon Serverless PostgreSQL)
DATABASE_URL=

# Auth (Auth.js / NextAuth)
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Auth Provider (GitHub OAuth)
# GitHub OAuth App callback URL: http://localhost:3000/api/auth/callback/github
# GitHub OAuth App에서 발급받은 값을 사용하세요.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Cache/Redis (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI (OpenAI API)
OPENAI_API_KEY=

# Internal & SEO
INTERNAL_API_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security (AES-256 Master Key & Webhook)
# 생성 방법: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
GITHUB_WEBHOOK_SECRET=

# Sentry (Error Monitoring)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Supabase Storage S3 (bucket은 브라우저 이미지 표시를 위해 Public으로 생성)
SUPABASE_STORAGE_ENDPOINT=https://project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_ACCESS_KEY=
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_BUCKET=

# Vercel Integration
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Chromium Execution Settings for PDF Export (보안 규격 PDF 내보내기용 크롬 환경 변수)
# 로컬 개발 환경용 크롬 실행 바이너리 절대 경로 (예: "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome")
LOCAL_CHROME_PATH=
# 인가 정책 디렉토리 접두사 목록 (운영 환경: "/var/task/,/tmp/" | 로컬: "/Applications/,/Users/" - 콤마로 구분)
ALLOWED_CHROMIUM_PREFIXES=
