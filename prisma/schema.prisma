generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  name               String?   @db.VarChar(100)
  avatar_url         String?
  github_login       String?   @unique @db.VarChar(100)
  github_id          BigInt?   @unique
  github_bio         String?
  github_bio_verified Boolean  @default(false)
  plan               String    @default("free") @db.VarChar(20)  // free | pro | team
  plan_expires_at    DateTime?
  ai_credits         Int       @default(3)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  integrations       Integration[]
  raw_projects       RawProject[]
  portfolios         Portfolio[]
  feed_items         FeedItem[]

  @@map("users")
}

model Account {
  id                  String  @id @default(uuid()) @db.Uuid
  userId              String  @db.Uuid
  type                String
  provider            String
  providerAccountId   String
  refresh_token       String?
  access_token        String?
  expires_at          Int?
  token_type          String?
  scope               String?
  id_token            String?
  session_state       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId], name: "provider_providerAccountId")
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Integration {
  id            String    @id @default(uuid()) @db.Uuid
  user_id       String    @db.Uuid
  provider      String    @db.VarChar(50)
  access_token  String?
  refresh_token String?
  metadata      Json?
  synced_at     DateTime?
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())

  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  feed_items FeedItem[]

  @@unique([user_id, provider])
  @@map("integrations")
}

model RawProject {
  id               String    @id @default(uuid()) @db.Uuid
  user_id          String    @db.Uuid
  source           String    @db.VarChar(50)
  external_id      String?   @db.VarChar(255)
  name             String    @db.VarChar(255)
  description      String?
  html_url         String?
  language         String?   @db.VarChar(100)
  topics           String[]
  stargazers_count Int       @default(0)
  forks_count      Int       @default(0)
  is_fork          Boolean   @default(false)
  pushed_at        DateTime?
  raw_data         Json?
  ai_summary       String?
  ai_tags          String[]
  ai_score         Float?
  is_featured      Boolean   @default(false)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, source, external_id])
  @@map("raw_projects")
}

model Portfolio {
  id               String    @id @default(uuid()) @db.Uuid
  user_id          String    @db.Uuid
  slug             String    @db.VarChar(100)
  title            String?   @db.VarChar(255)
  theme            String    @default("minimalist") @db.VarChar(50)
  design_tokens    Json?
  generation_mode  String    @default("auto") @db.VarChar(20)
  auto_published   Boolean   @default(true)
  custom_domain    String?
  is_published     Boolean   @default(false)
  seo_title        String?   @db.VarChar(255)
  seo_description  String?
  og_image_url     String?
  view_count       Int       @default(0)
  published_at     DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  user   User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  blocks PortfolioBlock[]

  @@unique([slug])
  @@map("portfolios")
}

model PortfolioBlock {
  id               String   @id @default(uuid()) @db.Uuid
  portfolio_id     String   @db.Uuid
  block_type       String   @db.VarChar(50)
  position         Int
  config           Json
  is_visible       Boolean  @default(true)
  is_ai_generated  Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  portfolio Portfolio @relation(fields: [portfolio_id], references: [id], onDelete: Cascade)

  @@map("portfolio_blocks")
}

model AnalyticsEvent {
  id           BigInt   @id @default(autoincrement())
  portfolio_id String   @db.Uuid
  event_type   String   @db.VarChar(50)
  block_id     String?  @db.Uuid
  session_id   String?  @db.VarChar(100)
  referrer     String?
  user_agent   String?
  country_code String?  @db.VarChar(10)
  created_at   DateTime @default(now())

  @@index([portfolio_id, created_at(sort: Desc)])
  @@map("analytics_events")
}

model FeedItem {
  id             String    @id @default(uuid()) @db.Uuid
  user_id        String    @db.Uuid
  integration_id String    @db.Uuid
  item_type      String?   @db.VarChar(50)
  title          String?   @db.VarChar(500)
  url            String?
  published_at   DateTime?
  metadata       Json?
  created_at     DateTime  @default(now())

  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integration_id], references: [id], onDelete: Cascade)

  @@map("feed_items")
}
